# Server-only: URL for flow-ai to reach voice backend (Docker internal hostname)
VOICE_BACKEND_URL=http://voice-backend:8000

# Browser: Node API (workflow CRUD, auth)
VITE_API_URL=http://localhost:3001

# Server-only: Node API from inside Docker (server functions like createVoiceSession)
API_URL=http://backend:3001

# Browser mic test WebSocket mode: direct (local dev) or proxy (deploy via backend :3001)
VITE_VOICE_WS_MODE=direct

# Browser mic test UI is served by flow-ai at /voice-mic-ui.html?session=<id>
# direct: WebSocket to voice-backend :8000
# proxy: WebSocket via backend /voice/ws/audio (requires USE_WS_PROXY=1 on backend)
