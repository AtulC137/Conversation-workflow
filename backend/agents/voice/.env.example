SARVAM_API_KEY=your_sarvam_key_here

# --- Speech-to-text (Sarvam saaras:v3 streaming) ---
# Language for STT. "unknown" attempts auto-detect; set a concrete code such as
# en-IN or hi-IN if auto-detect yields no transcripts.
STT_LANGUAGE_CODE=unknown
# High VAD sensitivity = snappier 0.5s end-of-speech boundary (recommended for
# conversational agents). Set to 0 for the slower ~1s boundary.
STT_HIGH_VAD=1

# --- Text-to-speech (Sarvam bulbul:v3 streaming) ---
# Lower min buffer = first audio sooner (may sound choppier). Default 30.
TTS_MIN_BUFFER_SIZE=30
# Speech rate: 1.0 = normal, 1.2–1.5 = faster. Default 1.2.
TTS_PACE=1.2

# --- Conversation timing ---
# Seconds of caller silence before the workflow advances via its no-response
# wire (i.e. gives up waiting for the caller). Kept generous so a real first
# turn is not cut off. Per-node silenceTimeoutSec overrides this.
SILENCE_TIMEOUT_SEC=3



# Telephony provider: piopiy | frejun | sip
# SIP trunk (Asterisk + AudioSocket) is recommended for FreJun PSTN calls.
TELEPHONY_PROVIDER=sip



# --- PIOPIY (when TELEPHONY_PROVIDER=piopiy) ---

PIOPIY_AGENT_ID=

PIOPIY_AGENT_TOKEN=

PIOPIY_CALLER_ID=

PIOPIY_DEBUG=0



# --- FreJun / Teler HTTP API (when TELEPHONY_PROVIDER=frejun) ---

TELER_API_KEY=

FREJUN_FROM_NUMBER=

# Public HTTPS base URL Teler can reach (ngrok/Cloudflare tunnel → voice-backend port 8000)
# Example: ngrok http 8000  →  FREJUN_PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
FREJUN_PUBLIC_BASE_URL=

# Optional separate status webhook (defaults to {FREJUN_PUBLIC_BASE_URL}/frejun/webhook)
FREJUN_STATUS_CALLBACK_URL=

FREJUN_WEBHOOK_SECRET=

# WebSocket media only (TELEPHONY_PROVIDER=frejun). Ignored when TELEPHONY_PROVIDER=sip.
# PCM16 base64 chunks — not used for SIP trunk (codecs negotiated via SDP instead).
FREJUN_STREAM_CHUNK_MS=500

FREJUN_STREAM_SAMPLE_RATE=16k

# Inbound DID → workflow mapping (JSON)

# FREJUN_INBOUND_DID_MAP={"+919876543210":{"workflowId":"<uuid>","userId":"<uuid>"}}

FREJUN_INBOUND_DID_MAP=

FREJUN_INBOUND_SYSTEM_USER_ID=



# --- FreJun SIP trunk (when TELEPHONY_PROVIDER=sip) ---
# SIP/RTP: PCMU (G.711 ulaw) and PCMA (G.711 alaw) negotiated via SDP at 8 kHz.
# ptime 20 ms offered via allow=ulaw:20,alaw:20 + use_ptime=yes in Asterisk pjsip.conf.
# maxptime 60 ms accepted from peer SDP offers (no separate config knob).
# AudioSocket bridge: 8 kHz slin, 20 ms frames. STT/TTS pipeline stays 16 kHz (resampled in audiosocket transport).
# FREJUN_STREAM_CHUNK_MS / FREJUN_STREAM_SAMPLE_RATE do not apply in SIP mode.

# Trunk domain from FreJun dashboard (Termination URL)

SIP_TRUNK_DOMAIN=your-trunk-domain

# FreJun IP auth — FreJun server IP for inbound identify (default: 3.7.75.192)
# SIP_TRUNK_IDENTIFY_MATCH=3.7.75.192

SIP_TRUNK_CALLER_ID=+918065179582
# From header user part (defaults to SIP_TRUNK_CALLER_ID; FreJun requires + in E.164)
# SIP_TRUNK_FROM_USER=+918065179582

# SIP signaling: transport-tcp (default) | transport-udp | transport-tls (set SIP_TRUNK_SECURE=1)
SIP_TRUNK_SECURE=0

# RTP keepalive / timeout (seconds). During a long one-way AI monologue the caller
# sends no RTP, so the UDP/NAT media mapping can expire (~30s) and Asterisk drops the
# call mid-message. rtp_keepalive makes Asterisk send periodic RTP during silence to
# hold the mapping open; rtp_timeout is a generous guard for genuinely dead media.
SIP_RTP_KEEPALIVE=5
SIP_RTP_TIMEOUT=120

# Used when SIP_TRUNK_SECURE=0. entrypoint.sh respects this; defaults to transport-tcp.
SIP_ASTERISK_TRANSPORT=transport-tcp

# Public IP the trunk whitelists (FreJun Outbound Auth IP / Inbound SIP URL host).
# Set this when Asterisk runs behind NAT/Docker: it is advertised in SIP Via/Contact
# and SDP (external_signaling_address / external_media_address) so media flows and
# header/IP-based trunk auth matches. Leave unset for a public-IP host.
# SIP_EXTERNAL_IP=203.0.113.10
# LAN/container subnet treated as local (default 172.16.0.0/12 covers Docker).
# SIP_LOCAL_NET=172.16.0.0/12

# Outbound digest auth (OPTIONAL). FreJun trunks default to IP authentication; only
# set these if the trunk challenges the outbound INVITE and Asterisk logs
# "no auth ids available". When both are set, entrypoint.sh wires an [frejun-trunk-auth]
# section and outbound_auth on the endpoint. Username is usually the trunk name or
# caller number; password is the trunk Secret from the FreJun dashboard.
# SIP_TRUNK_USERNAME=trunk_001
# SIP_TRUNK_PASSWORD=your-trunk-secret



# Asterisk AMI (voice-backend originates outbound calls)

ASTERISK_AMI_HOST=asterisk

ASTERISK_AMI_PORT=5038

ASTERISK_AMI_USER=voiceagent

ASTERISK_AMI_SECRET=changeme



# AudioSocket media bridge (sip-media-bridge container)

SIP_AUDIOSOCKET_HOST=0.0.0.0

SIP_AUDIOSOCKET_PORT=9092

SIP_AUDIOSOCKET_PEER=sip-media-bridge

VOICE_BACKEND_URL=http://voice-backend:8000



# Inbound DID → workflow mapping (JSON, same shape as FREJUN_INBOUND_DID_MAP)

# SIP_INBOUND_DID_MAP={"+918065179582":{"workflowId":"<uuid>","userId":"<uuid>"}}

SIP_INBOUND_DID_MAP=

SIP_INBOUND_SYSTEM_USER_ID=

